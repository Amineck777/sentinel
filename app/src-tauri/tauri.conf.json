{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SENTINEL",
  "version": "0.1.0",
  "identifier": "dev.yuto.sentinel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SENTINEL",
        "width": 920,
        "height": 680,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/sentinel-core"],
    "icon": ["icons/icon.png"]
  }
}
